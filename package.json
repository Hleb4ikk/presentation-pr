{
  "name": "presentation-pr",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:migrate:dev": "npx prisma db migrate --advance-ref db",
    "db:migrate:prod": "npx prisma db migrate",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/cli-engine": "0.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.24",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.10",
    "graphql": "^16.15.0",
    "graphql-scalars": "^2.0.1",
    "prisma": "8.0.0-rc.34",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
